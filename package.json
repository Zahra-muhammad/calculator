{
  "name": "uae-ct-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "UAE Corporate Tax calculator for tax staff. Runs entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:single": "node scripts/build-single.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sample": "node scripts/make-sample.mjs",
    "check:single": "node scripts/check-single.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.9",
    "pdfjs-dist": "4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "^1.65.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
